# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173/

# ---- MongoDB Database ----
# Get this free from MongoDB Atlas: https://www.mongodb.com/cloud/atlas/register
# Create a free (M0) cluster, add a database user, allow your IP (or 0.0.0.0/0 for dev),
# then copy the connection string from "Connect > Drivers" and paste it here.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/selvam_maligai_store?retryWrites=true&w=majority"

# ---- JWT ----
# Generate your own with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_your_own_random_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_your_own_random_64_byte_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Cookies ----
COOKIE_SECRET=replace_with_your_own_random_64_byte_hex_secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax


# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ---- Account lockout ----
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ---- Owner seed account (created automatically on first run) ----
OWNER_EMAIL=owner@selvammaligai.store
OWNER_PASSWORD=change_this_before_first_run

# ---- Uploads ----
UPLOAD_DIR=uploads/products
MAX_UPLOAD_SIZE_MB=5
