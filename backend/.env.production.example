NODE_ENV=production
PORT=5000

CLIENT_URL=https://your-app-name.onrender.com

# MongoDB Atlas connection string (Production project/cluster)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/selvam_maligai_store?retryWrites=true&w=majority"

JWT_ACCESS_SECRET=CREATE_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CREATE_ANOTHER_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=CREATE_A_LONG_RANDOM_SECRET
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
